# ReaktRailAi preset for JetPack 7 / Jetson Linux R39
COMPOSE_PROFILES=jetpack7
RESTART_POLICY=unless-stopped

# Only this value normally needs to be changed.
# Local video files are not accepted here; use an RTSP or RTSPS stream URL.
CAMERA_RTSP_URL=rtsp://CHANGE-ME:8554/input

# Included unified rail and object segmentation model
MODEL_PATH=./model/reaktrailai-yolo26m-seg.pt
MODEL=/app/model/reaktrailai-yolo26m-seg.pt
EXPORT_DIR=/models/exports

# Jetson Orin / TensorRT FP16
DEVICE=cuda:0
DEVICE_FALLBACK=cpu
MODEL_FORMAT=tensorrt
MODEL_PRECISION=fp16
IMGSZ=640
TRT_WORKSPACE=4

# Hardware video pipeline
INPUT_DECODER=nvv4l2
VAAPI_DEVICE=auto
WEBRTC_ENABLED=1
WEBRTC_ENCODER=nvv4l2
OUTPUT_FPS=30
H264_BITRATE_KBPS=30000
RTP_BUFFER_BYTES=4194304

# Detection and overlay
RAIL_CONFIDENCE=0.25
OBJECT_CONFIDENCE=0.25
OBJECT_HOLD_SECONDS=1.0

# API and WebUI
API_ENABLED=1
API_HOST=0.0.0.0
API_PORT=5000
WEBUI_AI_HOST=
WEBUI_STATUS_INTERVAL_MS=1000
WEBUI_DEBUG=0

# Optional diagnostics and recording; disabled by default
LATENCY_CSV=
STATUS_JSON=
MAX_FRAMES=0
RESULTS_PATH=./results
RECORD_DIR=
RECORD_ANNOTATED=0
DEBUG_DISPLAY=0
