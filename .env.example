# Genau ein Profil aktivieren: cuda, rocm, jetpack5, jetpack6 oder jetpack7
COMPOSE_PROFILES=cuda
RESTART_POLICY=unless-stopped

# RTSP-Kamera und das mitgelieferte einheitliche YOLO-Segmentierungsmodell
CAMERA_RTSP_URL=rtsp://camera.example:8554/input
MODEL_PATH=./model/reaktrailai-yolo26m-seg.pt

# Laufzeit und Modell
DEVICE=cuda:0
DEVICE_FALLBACK=cpu
MODEL_FORMAT=tensorrt
MODEL_PRECISION=fp16
MODEL=/app/model/reaktrailai-yolo26m-seg.pt
EXPORT_DIR=/models/exports
INPUT_DECODER=auto
VAAPI_DEVICE=auto
MIGRAPHX_DISABLE_REDUCE_FUSION=1

# INT8-Kalibrierung; nur bei MODEL_PRECISION=int8 erforderlich
INT8_DATA=/calibration/data.yaml
INT8_CALIBRATION_PATH=.
INT8_CALIBRATION_SAMPLES=256
TRT_WORKSPACE=4

# Inferenz und Darstellung
IMGSZ=640
RAIL_CONFIDENCE=0.25
OBJECT_CONFIDENCE=0.15
OBJECT_HOLD_SECONDS=1.0

# WebRTC-Ausgabe
WEBRTC_ENABLED=1
WEBRTC_ENCODER=auto
OUTPUT_FPS=25
H264_BITRATE_KBPS=30000
RTP_BUFFER_BYTES=4194304

# API, Diagnose und optionale Aufzeichnung
API_ENABLED=1
API_HOST=0.0.0.0
API_PORT=5000
LATENCY_CSV=
STATUS_JSON=
MAX_FRAMES=0
RESULTS_PATH=./results
RECORD_DIR=
RECORD_ANNOTATED=0
DEBUG_DISPLAY=0

# Weboberfläche; leer bedeutet: Hostnamen aus der Browseradresse verwenden
WEBUI_AI_HOST=
WEBUI_STATUS_INTERVAL_MS=1000
WEBUI_DEBUG=0
